#!/bin/bash

# CCify_Video.command
# Launcher for CCify Video - Enterprise-Grade CLI Tool v2.0
#
# This wrapper launches the Python-based CLI tool with full enterprise features:
# - Drag-and-drop or manual path entry
# - Batch processing with parallel execution
# - Enterprise error handling and logging
# - Interactive menu and non-interactive automation
# - Comprehensive progress tracking

set -euo pipefail

# ------- colors -------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

error()   { echo -e "${RED}[ERROR]${NC} $*"; }
info()    { echo -e "${CYAN}[INFO]${NC}  $*"; }
success() { echo -e "${GREEN}[OK]${NC}    $*"; }
warn()    { echo -e "${YELLOW}[WARN]${NC}  $*"; }

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
CCIFY_CLI="$SCRIPT_DIR/whisper.cpp/ccify_cli.py"
PYTHON3_PATH="/opt/homebrew/bin/python3"

# ------- pre-flight checks -------
if [ ! -f "$PYTHON3_PATH" ]; then
  error "Python 3 not found at $PYTHON3_PATH"
  error "Please install Python 3 via Homebrew: brew install python3"
  echo ""
  read -p "Press Enter to exit..."
  exit 1
fi

if [ ! -f "$CCIFY_CLI" ]; then
  error "CCify CLI not found at $CCIFY_CLI"
  error "Please ensure ccify_cli.py is in the correct location"
  echo ""
  read -p "Press Enter to exit..."
  exit 1
fi

# ------- show current settings and offer to reconfigure -------
show_cc_settings
read -p "Change settings? (y/N): " do_cfg
if [[ "$do_cfg" =~ ^[Yy]$ ]]; then
  configure_cc
  clear
  banner
fi
show_cc_settings

# ------- ask for file -------
echo "\nDrag and drop your VIDEO file here, then press Enter:"
read -r INPUT_PATH
# Remove surrounding quotes (single or double)
INPUT_PATH=${INPUT_PATH#\'};INPUT_PATH=${INPUT_PATH%\'}
INPUT_PATH=${INPUT_PATH#\"};INPUT_PATH=${INPUT_PATH%\"}
# Handle escaped spaces from drag-and-drop
INPUT_PATH=$(echo "$INPUT_PATH" | sed 's/\\ / /g')

if [ ! -f "$INPUT_PATH" ]; then
  error "File not found: $INPUT_PATH"
  exit 1
fi

BASENAME_WITH_EXT="$(basename -- "$INPUT_PATH")"
BASENAME_NO_EXT="${BASENAME_WITH_EXT%.*}"
ext="${BASENAME_WITH_EXT##*.}"
ext_lc="$(echo "$ext" | tr '[:upper:]' '[:lower:]')"

# ------- working folder in Downloads -------
TS="$(date +%Y%m%d-%H%M%S)"
OUT_ROOT="$HOME/Downloads/CCify"
OUT_DIR="$OUT_ROOT/${BASENAME_NO_EXT}_${TS}"
mkdir -p "$OUT_DIR"

info "Working folder: $OUT_DIR"

# ------- copy original video -------
info "Copying original video ..."
cp -p "$INPUT_PATH" "$OUT_DIR/$BASENAME_WITH_EXT"
success "Copied"

cd "$OUT_DIR"

# ------- extract audio for ASR (keep original audio for final) -------
EXTRACT_WAV="${BASENAME_NO_EXT}_extracted.wav"
info "Extracting audio for transcription (16k mono PCM) ..."
ffmpeg -hide_banner -loglevel error -y \
  -i "$BASENAME_WITH_EXT" -vn -ac 1 -ar 16000 -c:a pcm_s16le "$EXTRACT_WAV"
success "Audio extracted: $EXTRACT_WAV"

# ------- run transcription to SRT -------
CAP_PREFIX="${BASENAME_NO_EXT}_cc"
# ------- prompt for model / language -------
echo ""
echo "Model options (fast → accurate):"
echo "  tiny, tiny.en, base, base.en, small, small.en, medium, medium.en"
echo "Leave blank to use current: $CC_MODEL"
read -p "Enter model: " MODEL_CHOICE
MODEL_CHOICE=${MODEL_CHOICE:-$CC_MODEL}

echo ""
echo "Language code (e.g., en, es, fr). Leave blank for current (${CC_LANG:-auto})"
read -p "Enter language: " LANG_CHOICE
LANG_CHOICE=${LANG_CHOICE:-$CC_LANG}

info "Transcribing with MLX Whisper (model=$MODEL_CHOICE, aggressive preproc) ..."
if [ -n "$LANG_CHOICE" ]; then
  python3 "$PY_TOOL" "$EXTRACT_WAV" --aggressive --srt -o "$CAP_PREFIX" -m "$MODEL_CHOICE" -l "$LANG_CHOICE" -q || {
    error "Transcription failed"
    exit 1
  }
else
  python3 "$PY_TOOL" "$EXTRACT_WAV" --aggressive --srt -o "$CAP_PREFIX" -m "$MODEL_CHOICE" -q || {
    error "Transcription failed"
    exit 1
  }
fi

CAP_SRT="${CAP_PREFIX}.srt"
if [ ! -f "$CAP_SRT" ]; then
  error "Expected SRT not found: $CAP_SRT"
  exit 1
fi
success "Created captions: $CAP_SRT"

# ------- options for output formatting -------
echo ""
echo "Output options:"
if [ "$CC_BURN_IN" = "1" ]; then
  echo "  1) Embed soft subtitles only"
  echo "  2) Embed soft subtitles AND create a burn-in copy (current default)"
else
  echo "  1) Embed soft subtitles only (current default)"
  echo "  2) Embed soft subtitles AND create a burn-in copy"
fi
read -p "Choose (1/2): " OUT_CHOICE
if [ -z "$OUT_CHOICE" ]; then
  OUT_CHOICE=$([ "$CC_BURN_IN" = "1" ] && echo 2 || echo 1)
fi

echo ""
if [ "$CC_FORCE_MP4" = "1" ]; then
  echo "Force MP4 output with re-encode? (Y/n)"
else
  echo "Force MP4 output with re-encode? (y/N)"
fi
read -r FORCE_MP4

# ------- mux CC back with original video+audio (soft subs) -------
# Choose subtitle codec based on container or forced mp4
OUT_FILE=""
# decide final behavior for force mp4
if [ -z "$FORCE_MP4" ]; then
  FORCE_MP4=$([ "$CC_FORCE_MP4" = "1" ] && echo Y || echo N)
fi

if [[ "$FORCE_MP4" =~ ^[Yy]$ ]]; then
  OUT_FILE="${BASENAME_NO_EXT}_CC.mp4"
  info "Forcing MP4 with re-encode and mov_text subtitles ..."
  ffmpeg -hide_banner -loglevel error -y \
    -i "$BASENAME_WITH_EXT" -i "$CAP_SRT" \
    -map 0 -map 1:0 \
    -c:v libx264 -preset "$CC_VIDEO_PRESET" -crf "$CC_VIDEO_CRF" \
    -c:a aac -b:a ${CC_AUDIO_BITRATE}k \
    -c:s mov_text \
    -metadata:s:s:0 language=eng -metadata:s:s:0 title="English" \
    "$OUT_FILE"
else
  case "$ext_lc" in
    mp4|m4v|mov)
      OUT_FILE="${BASENAME_NO_EXT}_CC.mp4"
      info "Embedding CC into MP4 container (mov_text, stream copy) ..."
      ffmpeg -hide_banner -loglevel error -y \
        -i "$BASENAME_WITH_EXT" -i "$CAP_SRT" \
        -map 0 -map 1:0 \
        -c copy -c:s mov_text \
        -metadata:s:s:0 language=eng -metadata:s:s:0 title="English" \
        "$OUT_FILE"
      ;;
    mkv)
      OUT_FILE="${BASENAME_NO_EXT}_CC.mkv"
      info "Embedding CC into MKV container (srt) ..."
      ffmpeg -hide_banner -loglevel error -y \
        -i "$BASENAME_WITH_EXT" -i "$CAP_SRT" \
        -map 0 -map 1:0 \
        -c copy -c:s srt \
        -metadata:s:s:0 language=eng -metadata:s:s:0 title="English" \
        "$OUT_FILE"
      ;;
    webm)
      OUT_FILE="${BASENAME_NO_EXT}_CC.webm"
      warn "WebM has limited embedded subtitle support; creating sidecar VTT instead."
      VTT_FILE="${CAP_PREFIX}.vtt"
      ffmpeg -hide_banner -loglevel error -y -i "$CAP_SRT" "$VTT_FILE"
      cp -p "$BASENAME_WITH_EXT" "$OUT_FILE"
      success "Created: $OUT_FILE (use sidecar: $VTT_FILE)"
      ;;
    *)
      # Default: attempt to preserve container with SRT
      OUT_FILE="${BASENAME_NO_EXT}_CC.${ext_lc}"
      warn "Unknown container '$ext_lc' – attempting generic SRT embed."
      ffmpeg -hide_banner -loglevel error -y \
        -i "$BASENAME_WITH_EXT" -i "$CAP_SRT" \
        -map 0 -map 1:0 \
        -c copy -c:s srt \
        -metadata:s:s:0 language=eng -metadata:s:s:0 title="English" \
        "$OUT_FILE" || {
          warn "Embed failed; leaving original plus captions sidecar in folder."
          OUT_FILE="$BASENAME_WITH_EXT"
        }
      ;;
  esac
fi

# ------- optional burn-in copy -------
BURN_FILE=""
if [ "$OUT_CHOICE" = "2" ]; then
  BURN_FILE="${BASENAME_NO_EXT}_CC_burned.mp4"
  info "Creating burn-in (hard) subtitles copy ..."
  # The subtitles filter uses libass; Homebrew ffmpeg typically includes it.
  # Escape font name for ASS style if it contains spaces/commas
  esc_font=$(printf %s "$CC_FONT_NAME" | sed "s/'/\\'/g")
  style="FontName=${esc_font},FontSize=${CC_FONT_SIZE},Outline=${CC_OUTLINE},BorderStyle=1,PrimaryColour=&H00FFFFFF&,OutlineColour=&H00000000&,Alignment=${CC_ALIGNMENT},MarginV=${CC_MARGIN_V}"
  ffmpeg -hide_banner -loglevel error -y \
    -i "$BASENAME_WITH_EXT" \
    -vf "subtitles='${CAP_SRT}':force_style='${style}'" \
    -c:v libx264 -preset "$CC_VIDEO_PRESET" -crf "$CC_VIDEO_CRF" \
    -c:a copy \
    "$BURN_FILE" || warn "Burn-in failed. Ensure your ffmpeg has libass."
fi

# ------- summary -------
cat <<EOF

${BOLD}Done!${NC}
  Input:     $INPUT_PATH
  Working:   $OUT_DIR
  Original:  $OUT_DIR/$BASENAME_WITH_EXT
  Captions:  $OUT_DIR/$CAP_SRT
  Output:    $OUT_DIR/$OUT_FILE
  Burn-in:   ${BURN_FILE:-(none)}

Tips:
  - Soft subs (embedded) can be toggled on/off in players
  - Burn-in produces a separate video with permanent captions
  - Force MP4 re-encode ensures a single MP4 output regardless of input
  - For WebM, use the generated .vtt sidecar if embedding is limited
EOF

# Reveal in Finder
if command -v open >/dev/null 2>&1; then
  if [ -n "${BURN_FILE:-}" ] && [ -f "$OUT_DIR/$BURN_FILE" ]; then
    open -R "$OUT_DIR/$BURN_FILE" || true
  else
    open -R "$OUT_DIR/$OUT_FILE" || true
  fi
fi
